#!/usr/bin/env python3
# mudra — a release-seal desk.
#
# Release manager for your own projects: CI publishes UNSIGNED artifacts + a
# sha256 manifest, and mudra derives a signing queue from reality — a
# published release missing its .sig IS a queue entry, an empty
# allowed_signers IS the unarmed state — then hands you one desk (CLI or
# local GUI) to arm anchors and seal manifests with a hardware key. mudra
# never holds key material: signing shells to ssh-keygen and the private
# halves never leave the FIDO2 keys. GPLv3, stdlib-only.
#
# `mudra init` walks you through configuring your own roster and key home on
# first run (see also `mudra keysetup` for minting the keys themselves). The
# GUI binds to 127.0.0.1 only. The one act mudra will never do on its own is
# the touch — that is yours, by design.

import http.server
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import webbrowser

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get("MUDRA_CONFIG_PATH",
                             os.path.join(HOME, ".config", "mudra", "config.json"))


def load_config():
    """Local, personal, never committed — same footing as keymap.json. Holds
    everything that would otherwise have to be hardcoded to one specific
    person's repo family: which repos to track, where the key home lives,
    how many signers, naming/namespace conventions. `mudra init` writes
    this; every MUDRA_* env var below still wins over it for a one-off
    override, same precedence as always."""
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


# mudra CAN track itself too, if you add "mudra" to your own roster — it's
# not exempt from the doctrine it enforces on anything else you track.
# self_path resolves to wherever THIS script's repo actually lives (not
# necessarily REPO_ROOT/mudra — matters if MUDRA_REPO_ROOT is overridden,
# e.g. by tests/smoke.sh's fixture roots), overriding the plain-name lookup.
# Three levels up from src/bin/mudra (REPO-STANDARD.md's tree fold, 2026-08-01)
# — two would land on src/ itself, silently pointing every self-lookup
# (VERSION, the anchor, packaging/VERSION) at the wrong directory. Fixed for
# the process lifetime (moving the script itself means restarting anyway).
_self_path = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# One version constant (REPO-STANDARD.md): read from packaging/VERSION at
# import time rather than hand-duplicated here, so the footer can never drift
# from the canonical file the way sutra's did for eleven straight commits
# (decision afda1ee0) — a literal MUDRA_VERSION string is exactly the shape
# check-repo's literal-version-string check exists to catch.
with open(os.path.join(_self_path, "packaging", "VERSION")) as _f:
    MUDRA_VERSION = _f.read().strip()

_config = {}
REPO_ROOT = KEY_HOME = KEY_PREFIX = SIGN_KEY = None
EXPECTED_KEYS = 4
NAMESPACE_TAG = ""
ROOT_LAYOUT_REPOS = set()
ROSTER = {}
REPOS = []
_config_mtime = None


def _derive_config():
    """(Re)compute _config and everything derived from it — REPO_ROOT,
    KEY_HOME, KEY_PREFIX, EXPECTED_KEYS, NAMESPACE_TAG, ROOT_LAYOUT_REPOS,
    ROSTER, REPOS, SIGN_KEY — honoring MUDRA_* env precedence exactly as
    always (env still wins over file). Called once at import, and again
    whenever CONFIG_PATH's mtime moves (reload_config_if_stale, below).

    Before this function existed, all of the above were derived ONCE at
    IMPORT TIME and then frozen for the process lifetime — write_config()
    persisted a new config.json but touched none of them, so mudra's own
    setup tab could save a new roster, report success, and keep serving
    the old one until the process happened to die. An operator's own
    hand-edit to config.json hit the identical freeze; only a restart of
    the mudra.service unit corrected it. That is ruling 41b72476 word for
    word — "a layer-3 verb succeeds when the pill's OWN OBSERVATION
    changes, never when its file is written" — broken inside the repo
    that enforces it on the other six (Alfred msg 3439)."""
    global _config, REPO_ROOT, KEY_HOME, KEY_PREFIX, EXPECTED_KEYS, \
        NAMESPACE_TAG, ROOT_LAYOUT_REPOS, ROSTER, REPOS, SIGN_KEY, _config_mtime
    _config = load_config()
    REPO_ROOT = os.environ.get(
        "MUDRA_REPO_ROOT",
        os.path.expanduser(_config.get("repo_root", os.path.join(HOME, "code", "REPOS"))))
    KEY_HOME = os.environ.get(
        "MUDRA_KEY_HOME",
        os.path.expanduser(_config.get("key_home", os.path.join(HOME, ".ssh", "mudra-master"))))
    KEY_PREFIX = os.environ.get("MUDRA_KEY_PREFIX", _config.get("key_prefix", "master"))
    EXPECTED_KEYS = int(os.environ.get("MUDRA_EXPECTED_KEYS", _config.get("expected_keys", 4)))
    NAMESPACE_TAG = os.environ.get("MUDRA_NAMESPACE_TAG", _config.get("namespace_tag", ""))
    # Repos NOT on the packaging/ layout (no packaging/VERSION; anchor sits at
    # the pre-convergence root release-signing/ instead) — rare, NAMED
    # per-repo exceptions, never a generic root-or-packaging probe for
    # everyone (a probe that assumed either layout for every repo once let a
    # real armed anchor go invisible — see docs/ARCHITECTURE.md). Empty by
    # default; add your own repo's name here only if it genuinely isn't
    # shaped like a packaging/-layout repo, never as a blanket "maybe" for
    # the whole roster.
    _root_layout_env = os.environ.get("MUDRA_ROOT_LAYOUT_REPOS")
    if _root_layout_env is not None:
        ROOT_LAYOUT_REPOS = {r for r in _root_layout_env.split(",") if r}
    else:
        ROOT_LAYOUT_REPOS = set(_config.get("root_layout_repos", []))
    # Roster entries are names under REPO_ROOT, or paths (anything with a
    # "/"). ROSTER maps display name -> absolute path; order is the desk's
    # card order. Empty by default — this is YOUR roster, not a shipped list
    # of someone else's projects. `mudra init` walks you through building it;
    # MUDRA_REPOS (comma-separated) overrides the config file for a one-off
    # run.
    _repos_env = os.environ.get("MUDRA_REPOS")
    _repo_entries = ([r for r in _repos_env.split(",") if r] if _repos_env is not None
                     else list(_config.get("repos", [])))
    _roster = {}
    for _e in _repo_entries:
        if _e == "mudra":
            _p = _self_path
        else:
            _p = os.path.expanduser(_e) if "/" in _e else os.path.join(REPO_ROOT, _e)
        _roster[os.path.basename(_p.rstrip("/"))] = _p
    ROSTER = _roster
    REPOS = list(ROSTER)
    SIGN_KEY = os.environ.get("MUDRA_SIGN_KEY", os.path.join(KEY_HOME, f"id_{KEY_PREFIX}_1"))
    try:
        _config_mtime = os.path.getmtime(CONFIG_PATH)
    except OSError:
        _config_mtime = None


def reload_config_if_stale():
    """Cheap per-request check (one stat(), not a hash or a full reparse):
    has config.json moved since we last read it? Covers write_config()'s
    own atomic save AND an external hand-edit — the path the operator
    actually took (msg 3439), which a write_config()-only reload hook
    would have missed entirely. Called at the top of every HTTP request
    and CLI invocation."""
    try:
        mtime = os.path.getmtime(CONFIG_PATH)
    except OSError:
        mtime = None
    if mtime != _config_mtime:
        _derive_config()


_derive_config()
PORT = int(os.environ.get("MUDRA_PORT", "7770"))
KEYMAP_PATH = os.environ.get("MUDRA_KEYMAP_PATH",
                             os.path.join(HOME, ".config", "mudra", "keymap.json"))
POLKIT_ACTION = "com.mudra.open-desk"
SESSION_PATH = os.path.join(HOME, ".config", "mudra", "session.json")


# ------------------------------------------------- physical key detection
# The ladder: serial where the hardware offers one, model-fingerprint where
# it doesn't (works while only ONE serial-less key exists), learned on first
# successful seal, manual pick as the floor. A wrong pick can only ever fail
# cleanly — the authenticator enforces handle↔credential cryptographically.

_FP_CACHE = {"t": 0.0, "fp": None}


def device_fingerprint():
    """Fingerprint the ONE connected FIDO key, or None if 0/many/unknown."""
    now = time.time()
    if now - _FP_CACHE["t"] < 3:
        return _FP_CACHE["fp"]
    fp = None
    rc, out, _ = run(["ykman", "list", "--serials"], timeout=10)
    serials = [l.strip() for l in out.splitlines() if l.strip()] if rc == 0 else []
    if len(serials) == 1:
        fp = "serial:" + serials[0]
    else:
        rc, out, _ = run(["ykman", "list"], timeout=10)
        models = [l.strip() for l in out.splitlines() if l.strip()] if rc == 0 else []
        if len(models) == 1:
            fp = "model:" + re.sub(r"\s*\[.*$", "", models[0])
    _FP_CACHE.update(t=now, fp=fp)
    return fp


def load_keymap():
    try:
        with open(KEYMAP_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def learn_key(fp, n):
    m = load_keymap()
    m[fp] = n
    os.makedirs(os.path.dirname(KEYMAP_PATH), exist_ok=True)
    with open(KEYMAP_PATH, "w") as f:
        json.dump(m, f, indent=1)


def keyslot_status():
    """The wizard's whole picture in one call: which of the EXPECTED_KEYS
    handles already have a public half on disk, and whether the physical
    key plugged in right now is already mapped to one of them."""
    fp = device_fingerprint()
    mapped_slot = load_keymap().get(fp) if fp else None
    slots = []
    for n in range(1, EXPECTED_KEYS + 1):
        pub_path = os.path.join(KEY_HOME, f"id_{KEY_PREFIX}_{n}.pub")
        try:
            with open(pub_path) as f:
                line = f.read().strip()
        except OSError:
            line = None
        slot = {"slot": n, "present": bool(line)}
        if line:
            parts = line.split()
            slot["comment"] = parts[2] if len(parts) > 2 else None
            rc, out, _ = run(["ssh-keygen", "-l", "-f", pub_path])
            slot["fingerprint"] = out.strip() if rc == 0 else None
        slots.append(slot)
    return {"key_home": KEY_HOME, "key_home_exists": os.path.isdir(KEY_HOME),
            "slots": slots, "detected_fp": fp, "mapped_slot": mapped_slot,
            "expected_keys": EXPECTED_KEYS}


def keymap_register(slot):
    """The low-risk half of the wizard: 'the key plugged in right now IS
    handle N' — writes the mapping a successful seal would have learned on
    its own, without waiting for one. No generation, no touch, no lock;
    it only ever writes keymap.json."""
    if slot not in range(1, EXPECTED_KEYS + 1):
        raise RuntimeError(f"slot must be 1..{EXPECTED_KEYS}")
    fp = device_fingerprint()
    if not fp:
        raise RuntimeError("no single connected key detected — plug in exactly "
                           "one key and retry")
    learn_key(fp, slot)
    return fp


def setup_status():
    """The effective configuration right now, post env>config>default
    precedence — what the GUI's Setup panel shows. "repos" is the RAW
    config.json entries specifically (not the resolved ROSTER basenames),
    so a save-without-editing round-trips a path like "~/code/rotten-apple"
    byte for byte instead of silently collapsing it to a bare name that
    would then resolve under repo_root instead."""
    return {"config_path": CONFIG_PATH, "repo_root": REPO_ROOT,
            "repos": list(_config.get("repos", [])), "key_home": KEY_HOME,
            "key_prefix": KEY_PREFIX, "expected_keys": EXPECTED_KEYS,
            "namespace_tag": NAMESPACE_TAG}


def write_config(new_config):
    """Persist the setup wizard's fields to CONFIG_PATH, atomically (tmp +
    rename, same discipline as write_session()). Preserves
    root_layout_repos from whatever's already on disk — an advanced field
    neither the CLI nor GUI wizard prompts for, so silently dropping it on
    save would be a real regression for anyone who set it by hand."""
    merged = dict(new_config)
    if _config.get("root_layout_repos"):
        merged["root_layout_repos"] = _config["root_layout_repos"]
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp = CONFIG_PATH + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(merged, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONFIG_PATH)


def run(cmd, cwd=None, timeout=120, input_=None, env=None):
    """Run a command; return (rc, stdout, stderr). Never raises on rc != 0."""
    try:
        p = subprocess.run(cmd, cwd=cwd, timeout=timeout, input=input_,
                           capture_output=True, text=True,
                           env={**os.environ, **env} if env else None,
                           stdin=subprocess.DEVNULL if input_ is None else None)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"{' '.join(cmd)}: timeout"


# ---------------------------------------------------------------- discovery

def canon_pubs():
    """The canonical public halves from the operator's key home."""
    if not os.path.isdir(KEY_HOME):
        return None
    pubs = []
    for name in sorted(os.listdir(KEY_HOME)):
        if name.endswith(".pub"):
            with open(os.path.join(KEY_HOME, name)) as f:
                line = f.read().strip()
            if line:
                pubs.append(line)
    return pubs


def anchor_lines(path):
    """Non-comment, non-blank lines of an allowed_signers file."""
    try:
        with open(path) as f:
            return [l.strip() for l in f
                    if l.strip() and not l.strip().startswith("#")]
    except OSError:
        return None


def embedded_block(install_sh):
    """The RELEASE_ALLOWED_SIGNERS='...' content embedded in install.sh.
    Single-quoted by family convention (coldspot's sync-signers): single
    quotes span lines and hold the namespaces=\"...\" double quotes unescaped."""
    try:
        with open(install_sh) as f:
            m = re.search(r"RELEASE_ALLOWED_SIGNERS='([^']*)'", f.read())
        return m.group(1).strip() if m else None
    except OSError:
        return None


def gh_owner_repo(path):
    rc, out, _ = run(["git", "remote", "get-url", "origin"], cwd=path)
    if rc != 0:
        return None
    m = re.search(r"github\.com[:/]([^/]+/[^/.]+)", out.strip())
    return m.group(1) if m else None


def release_state(path, tag, no_remote=False):
    """What GitHub says about <tag>: published? manifest? sig? None if unknown."""
    if no_remote:
        return None
    slug = gh_owner_repo(path)
    if not slug:
        return None
    rc, out, _ = run(["gh", "release", "view", tag, "-R", slug,
                      "--json", "assets,isDraft"], timeout=30)
    if rc != 0:
        return {"published": False}
    try:
        doc = json.loads(out)
    except ValueError:
        return None
    assets = [a["name"] for a in doc.get("assets", [])]
    # Manifest dialects: <artifact>.sha256 (single-artifact, coldspot/kast)
    # or SHA256SUMS (Debian convention — preferred for multi-artifact, phanspeed).
    manifest = next((a for a in assets
                     if a == "SHA256SUMS" or
                     (a.endswith(".sha256") and not a.endswith(".sha256.sig"))), None)
    return {
        "published": not doc.get("isDraft", False),
        "assets": assets,
        "manifest": manifest,
        "sig": (manifest + ".sig") if manifest and (manifest + ".sig") in assets else None,
        "slug": slug,
    }


def _on_packaging_layout(path):
    return os.path.exists(os.path.join(path, "packaging", "VERSION"))


def version_path(path):
    return os.path.join(path, "packaging", "VERSION")


def anchor_file(path):
    name = os.path.basename(path.rstrip("/"))
    if name in ROOT_LAYOUT_REPOS:
        return os.path.join(path, "release-signing", "allowed_signers")
    return os.path.join(path, "packaging", "release-signing", "allowed_signers")


def anchor_rel(path):
    """The anchor as a repo-relative path, for the SCOPED arming commit."""
    return os.path.relpath(anchor_file(path), path)


def repo_state(name, no_remote=False):
    """Everything the desk knows about one repo, derived, no stored state."""
    path = ROSTER.get(name, os.path.join(REPO_ROOT, name))
    st = {"name": name, "path": path}
    if not os.path.isdir(os.path.join(path, ".git")):
        st["missing"] = True
        return st

    try:
        with open(version_path(path)) as f:
            st["version"] = f.read().strip()
    except OSError:
        # Cargo-workspace repos (rotten-apple) carry the version in Cargo.toml.
        st["version"] = None
        try:
            with open(os.path.join(path, "Cargo.toml")) as f:
                m = re.search(r'^version\s*=\s*"([^"]+)"', f.read(), re.M)
            st["version"] = m.group(1) if m else None
        except OSError:
            pass

    rc, out, _ = run(["git", "tag", "-l"], cwd=path)
    tags = out.split() if rc == 0 else []
    st["tagged"] = bool(st["version"]) and (f"v{st['version']}" in tags)
    rc, out, _ = run(["git", "status", "--porcelain", "-uno"], cwd=path)
    st["dirty"] = bool(out.strip()) if rc == 0 else None

    name_base = os.path.basename(path.rstrip("/"))
    if name_base not in ROOT_LAYOUT_REPOS and not _on_packaging_layout(path):
        # Matches neither the packaging/ layout nor the named root-layout
        # exception — a repo the desk doesn't recognize the shape of. Fail
        # LOUDLY (a distinct, visibly-wrong value) rather than silently
        # reading anchor=none, which would look identical to a normal,
        # expected not-yet-armed repo — exactly the silence that let a real
        # armed anchor go invisible on rotten-apple. audit() turns this into
        # a hard finding; investigate rather than guess.
        st["anchor"] = "unrecognized-layout"
        lines = None
    else:
        anchor_path = anchor_file(path)
        lines = anchor_lines(anchor_path)
        if lines is None:
            st["anchor"] = "none"
        elif not lines:
            st["anchor"] = "inert"
        else:
            st["anchor"] = "armed"
            st["anchor_keys"] = len(lines)
    emb = embedded_block(os.path.join(path, "install.sh"))
    if emb is not None:
        file_body = "\n".join(lines or [])
        st["embedded_ok"] = (emb == file_body)

    if st["version"] and st["tagged"]:
        st["release"] = release_state(path, f"v{st['version']}", no_remote)

    # The derived verdict, in queue order of urgency.
    rel = st.get("release")
    if st.get("missing"):
        st["state"] = "missing"
    elif not st["version"]:
        st["state"] = "no VERSION"
    elif not st["tagged"]:
        st["state"] = "untagged"
    elif rel is None:
        st["state"] = "tagged (remote unknown)"
    elif not rel.get("published"):
        st["state"] = "tagged, release not published (CI?)"
    elif not rel.get("manifest"):
        st["state"] = "published, NO MANIFEST (broken release)"
    elif not rel.get("sig"):
        st["state"] = "AWAITING SEAL"
    else:
        st["state"] = "sealed"
    return st


def scan(no_remote=False):
    return [repo_state(r, no_remote) for r in REPOS]


# ------------------------------------------------------------------- audit

def audit(no_remote=True):
    """Family invariants: same canonical keys in every armed anchor,
    embedded copies byte-identical, versions vs tags coherent."""
    pubs = canon_pubs()
    findings = []
    if pubs is None:
        findings.append(("key-home", "MISSING: " + KEY_HOME))
    elif len(pubs) != EXPECTED_KEYS:
        findings.append(("key-home", f"{len(pubs)} pubs, expected {EXPECTED_KEYS}"))
    canon_blobs = sorted(p.split()[1] for p in pubs) if pubs else []

    states = scan(no_remote)
    for st in states:
        n = st["name"]
        if st.get("missing"):
            findings.append((n, "repo missing from " + REPO_ROOT))
            continue
        if st["anchor"] == "unrecognized-layout":
            findings.append((n, "matches neither packaging/ layout nor a named "
                             "root-layout exception (ROOT_LAYOUT_REPOS) — "
                             "investigate before trusting anchor=none"))
            continue
        if st["anchor"] == "armed":
            lines = anchor_lines(anchor_file(st["path"]))
            # anchor line: principal namespaces="..." keytype BLOB comment
            blobs = sorted(l.split()[3] for l in lines if len(l.split()) >= 4)
            if canon_blobs and blobs != canon_blobs:
                findings.append((n, "armed anchor DIVERGES from canonical keys"))
            bad = [l for l in lines if f'namespaces="{n.lower()}-release' not in l
                   or not l.startswith(n.lower() + " ")]
            if bad:
                findings.append((n, f"{len(bad)} anchor line(s) with wrong principal/namespace"))
        if st.get("embedded_ok") is False:
            findings.append((n, "embedded install.sh copy != anchor file"))
        # dirty trees are status information, not audit findings — audit fails
        # only on broken INVARIANTS, or it would cry through every dev cycle
    return states, findings


# ------------------------------------------------------------ sync-signers

def sync_signers(name, dry=False):
    """Rebuild <repo>'s anchor (and any embedded twin) from the canonical key
    home. Rebuild-from-all, never append; refuses on != EXPECTED_KEYS."""
    pubs = canon_pubs()
    if pubs is None:
        raise SystemExit(f"key home missing: {KEY_HOME}")
    if len(pubs) != EXPECTED_KEYS:
        raise SystemExit(f"refusing: {len(pubs)} canonical pubs, expected {EXPECTED_KEYS}")
    path = ROSTER.get(name, os.path.join(REPO_ROOT, name))
    # Same floor as repo_state()'s own missing check (thread 6c3ec0b4):
    # without this, a stale roster entry for a renamed-away repo would
    # os.makedirs() + write a signer file into a path nothing tracks,
    # resurrecting it as an empty skeleton. Every caller (CLI's bare
    # `sync-signers`, the ceremony's arm, the GUI preview) gets this for
    # free rather than needing its own missing-check first.
    if not os.path.isdir(os.path.join(path, ".git")):
        raise SystemExit(f"refusing: {name} missing from {path} (renamed, or never cloned)")
    principal = name.lower()
    # "git" is git's own SSH-signing namespace (verified against git 2.53.0,
    # not assumed) -- distinct from the release-artifact namespace above it.
    # Emitted for every repo so `git tag -s`/`git verify-tag` work against
    # this same anchor; a repo's release-artifact namespace is unaffected.
    namespaces = f"{principal}-release" + (f",{NAMESPACE_TAG}" if NAMESPACE_TAG else "") + ",git"
    lines = []
    for p in pubs:
        parts = p.split()
        keytype, blob = parts[0], parts[1]
        comment = parts[2] if len(parts) > 2 else "master"
        lines.append(f'{principal} namespaces="{namespaces}" {keytype} {blob} {comment}')
    body = "\n".join(lines)
    anchor_path = anchor_file(path)
    if dry:
        return body
    os.makedirs(os.path.dirname(anchor_path), exist_ok=True)
    with open(anchor_path, "w") as f:
        f.write(body + "\n")
    install_sh = os.path.join(path, "install.sh")
    if embedded_block(install_sh) is not None:
        with open(install_sh) as f:
            content = f.read()
        # Embedded copy is BYTE-IDENTICAL to the anchor file, trailing newline
        # included — so a repo's CI may byte-compare the two naively and be
        # right. (tjmax's find: the 0.3.x writer omitted the newline in the
        # embedded copy, false-drifting every byte-for-byte check.)
        content = re.sub(r"RELEASE_ALLOWED_SIGNERS='[^']*'",
                         lambda _: "RELEASE_ALLOWED_SIGNERS='" + body + "\n'",
                         content)
        with open(install_sh, "w") as f:
            f.write(content)
    return body


# ---------------------------------------------------------------- ceremony

def _pin_env(tmp, title):
    """SSH_ASKPASS plumbing shared by every ceremony that needs a FIDO2 PIN
    (sign, generate): mudra's subprocess has no usable TTY (that fight is
    exactly what broke ceremony #1), so the PIN has to arrive via a GUI
    dialog, never the serve terminal. None if zenity isn't installed —
    callers fall back to a serve-terminal prompt."""
    if not shutil.which("zenity"):
        return None
    askpass = os.path.join(tmp, "askpass.sh")
    with open(askpass, "w") as f:
        f.write(f"#!/bin/sh\nexec zenity --password --title='{title}'\n")
    os.chmod(askpass, 0o700)
    return {"SSH_ASKPASS": askpass, "SSH_ASKPASS_REQUIRE": "force"}


class Ceremony:
    """One ceremony at a time (arm, seal, or key setup, any repo or slot);
    steps stream into a log the GUI polls. Arm and seal are two SEPARATE
    acts, deliberately: arm needs only the public keys and must work on a
    repo with no tag at all; seal needs the operator's physical touch and a
    published release. Key setup is a third, rarer act — minting or
    replacing a slot's hardware-backed identity — sharing the same lock
    because it writes into KEY_HOME an in-flight arm's sync_signers() call
    might be reading from concurrently."""
    def __init__(self):
        self.lock = threading.Lock()
        self.log = []
        self.active = None    # repo name (or "key setup: slot N") while running
        self.done = None      # "armed" | "sealed" | "provisioned" | "failed"

    def say(self, msg):
        self.log.append({"t": time.strftime("%H:%M:%S"), "msg": msg})

    def _begin(self, name):
        with self.lock:
            if self.active:
                raise RuntimeError(f"ceremony already running for {self.active}")
            self.active, self.done, self.log = name, None, []

    def arm(self, name):
        self._begin(name)
        try:
            st = repo_state(name)
            if st.get("missing"):
                raise RuntimeError("repo missing from " + REPO_ROOT)
            if st["anchor"] == "armed":
                raise RuntimeError(f"{name} is already armed")
            if st["anchor"] == "unrecognized-layout":
                raise RuntimeError(f"{name} matches neither a known layout nor a "
                                   "named exception — investigate before arming")
            self._arm(name, st["path"])
            self.done = "armed"
        except Exception as exc:
            self.say(f"FAILED: {exc}")
            self.done = "failed"
        finally:
            self.active = None

    def _arm(self, name, path):
        """Rebuild the anchor from canon and commit+push it, scoped. The
        only place mudra writes into a tracked repo besides the seal's own
        upload — same two-file SCOPED add either way, never `git add -A`
        (a stray `-A` once swept a seat's untracked session files into a
        PUBLIC repo, coldspot, 2026-07-19 — the desk's one real incident)."""
        self.say(f"ARMING {name}: rebuilding anchor from {KEY_HOME}")
        try:
            sync_signers(name)
        except SystemExit as exc:
            # sync_signers() raises SystemExit for its CLI entry point's
            # clean traceback-free exit; a ceremony thread needs a normal
            # exception its own except-Exception (above) will actually see.
            raise RuntimeError(str(exc))
        self.say("anchor + embedded copy rebuilt (4 keys)")
        arm_files = [anchor_rel(path)]
        if embedded_block(os.path.join(path, "install.sh")) is not None:
            arm_files.append("install.sh")
        rc, out, err = run(["git", "add", "--"] + arm_files, cwd=path)
        rc2, _, err2 = run(["git", "commit", "-m",
                            "arm release verification: pin the master identity",
                            "--"] + arm_files, cwd=path)
        if rc or rc2:
            raise RuntimeError(f"arming commit failed: {err or err2}")
        rc, _, err = run(["git", "push"], cwd=path, timeout=60)
        if rc:
            raise RuntimeError(f"push failed: {err}")
        self.say("arming commit pushed — verification is now fail-closed")

    def seal(self, name, key_n=None):
        self._begin(name)
        try:
            self._seal(name, key_n)
            self.done = "sealed"
        except Exception as exc:
            self.say(f"FAILED: {exc}")
            if "invalid format" in str(exc):
                self.say("HINT: 'invalid format' after the touch usually means the "
                         "PLUGGED-IN key does not hold this handle's credential — "
                         "handle N pairs with physical key N. Pick the number of "
                         "the key that is actually inserted and retry.")
            self.done = "failed"
        finally:
            self.active = None

    def _seal(self, name, key_n=None):
        st = repo_state(name)
        path, ver = st["path"], st.get("version")
        if not ver:
            raise RuntimeError("no VERSION")
        tag = f"v{ver}"
        rel = st.get("release") or {}
        if not rel.get("published"):
            raise RuntimeError(f"{tag} is not a published release")
        if rel.get("sig"):
            raise RuntimeError(f"{tag} already carries a seal")
        manifest = rel.get("manifest")
        if not manifest:
            raise RuntimeError(f"{tag} has no sha256 manifest")
        slug = rel["slug"]

        if st["anchor"] != "armed":
            raise RuntimeError("anchor is not armed — arm it first "
                               "(this pins the master identity FAIL-CLOSED forever)")

        tmp = tempfile.mkdtemp(prefix="mudra-")
        try:
            self.say(f"downloading PUBLISHED manifest {manifest} from {slug} {tag}")
            rc, _, err = run(["gh", "release", "download", tag, "-R", slug,
                              "-p", manifest, "-D", tmp], timeout=60)
            if rc:
                raise RuntimeError(f"download failed: {err}")
            mpath = os.path.join(tmp, manifest)
            env = _pin_env(tmp, "mudra — FIDO2 PIN for the seal")
            if env:
                self.say("signing — PIN dialog will pop, then TOUCH YOUR KEY")
            else:
                self.say("zenity missing — PIN falls back to the serve terminal; "
                         "signing — TOUCH YOUR KEY NOW")
            sign_key = (os.path.join(KEY_HOME, f"id_{KEY_PREFIX}_{key_n}")
                        if key_n else SIGN_KEY)
            self.say(f"signing with handle {os.path.basename(sign_key)}")
            rc, _, err = run(["ssh-keygen", "-Y", "sign",
                              "-n", f"{name.lower()}-release",
                              "-f", sign_key, mpath], timeout=120, env=env)
            if rc:
                raise RuntimeError(f"sign failed: {err}")
            self.say("signed. uploading the seal")
            rc, _, err = run(["gh", "release", "upload", tag, mpath + ".sig",
                              "-R", slug, "--clobber"], timeout=60)
            if rc:
                raise RuntimeError(f"upload failed: {err}")

            self.say("verify-back as an end user: downloading all assets")
            vdir = os.path.join(tmp, "verify")
            os.makedirs(vdir)
            rc, _, err = run(["gh", "release", "download", tag, "-R", slug,
                              "-D", vdir], timeout=120)
            if rc:
                raise RuntimeError(f"verify download failed: {err}")
            rc, out, err = run(["sha256sum", "-c", manifest], cwd=vdir)
            if rc:
                raise RuntimeError(f"manifest hash check failed: {out} {err}")
            with open(os.path.join(vdir, manifest)) as f:
                mbytes = f.read()
            # path, not REPO_ROOT/name: a pre-existing bug for path-based
            # roster entries (rotten-apple lives outside REPO_ROOT entirely;
            # mudra only "worked" by coincidence, since it happens to sit
            # inside REPO_ROOT). Found while already in this function for
            # the arm/seal split — fixed alongside it.
            anchor = anchor_file(path)
            rc, out, err = run(["ssh-keygen", "-Y", "verify", "-f", anchor,
                                "-I", name.lower(), "-n", f"{name.lower()}-release",
                                "-s", os.path.join(vdir, manifest + ".sig")],
                               input_=mbytes)
            if rc:
                raise RuntimeError(f"signature verify-back failed: {err}")
            self.say(f"sealed: {name} {tag} — hash chain and signature verify "
                     "against the armed anchor, end-user path")
            if key_n:
                fp = device_fingerprint()
                if fp and load_keymap().get(fp) != key_n:
                    learn_key(fp, key_n)
                    self.say(f"learned: connected device ({fp}) = key {key_n} — "
                             "auto-selected from now on")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)

    def keysetup(self, slot, force=False):
        self._begin(f"key setup: slot {slot}")
        try:
            self._keysetup(slot, force)
            self.done = "provisioned"
        except Exception as exc:
            self.say(f"FAILED: {exc}")
            self.done = "failed"
        finally:
            self.active = None

    def _keysetup(self, slot, force=False):
        """Mint a brand-new hardware-backed master key into an empty slot —
        or, with force, replace an occupied one. mudra still never holds key
        material: -O resident means the private half exists only on the
        token itself, this only ever writes the public half plus a local
        handle stub that is useless without the physical key present and
        touched. Shares Ceremony's lock with arm/seal — it writes into
        KEY_HOME, which an in-flight arm's sync_signers() reads from."""
        if slot not in range(1, EXPECTED_KEYS + 1):
            raise RuntimeError(f"slot must be 1..{EXPECTED_KEYS}")
        os.makedirs(KEY_HOME, exist_ok=True)
        priv = os.path.join(KEY_HOME, f"id_{KEY_PREFIX}_{slot}")
        pub = priv + ".pub"
        if os.path.exists(pub) and not force:
            raise RuntimeError(f"slot {slot} already has a key — this refuses "
                               "without force (replacing it permanently retires "
                               "whatever device is registered there; every "
                               "anchor already armed with its public half needs "
                               "re-arming family-wide)")
        tmp = tempfile.mkdtemp(prefix="mudra-keysetup-")
        try:
            env = _pin_env(tmp, "mudra — FIDO2 PIN for key setup")
            if env:
                self.say("PIN dialog will pop if the token asks for one, "
                         "then TOUCH YOUR KEY NOW")
            else:
                self.say("zenity missing — PIN falls back to the serve terminal; "
                         "TOUCH YOUR KEY NOW")
            for f in (priv, pub):
                if os.path.exists(f):
                    os.remove(f)
            rp_id = f"{KEY_PREFIX.replace('_', '-')}-{slot}"
            rc, out, err = run(["ssh-keygen", "-t", "ed25519-sk", "-O", "resident",
                               "-O", f"application=ssh:{rp_id}",
                               "-N", "", "-C", rp_id, "-f", priv],
                               timeout=120, env=env)
            if rc:
                raise RuntimeError(f"generation failed: {err or out}")
            try:
                with open(pub) as f:
                    line = f.read().strip()
            except OSError:
                line = ""
            if not line:
                raise RuntimeError("generation reported success but wrote no public key")
            self.say(f"slot {slot} provisioned: {line.split()[0]} "
                     f"{line.split()[-1] if len(line.split()) > 2 else ''}".strip())
            fp = device_fingerprint()
            if fp:
                learn_key(fp, slot)
                self.say(f"learned: connected device ({fp}) = slot {slot}")
            self.say("this only fills the slot — nothing is armed yet; "
                     "arm each repo once all slots are the keys you want")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)


CEREMONY = Ceremony()


