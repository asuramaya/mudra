<script>
const chip=(t,c)=>`<span class="chip ${c}">${t}</span>`;
const keysel=document.getElementById('keysel');
keysel.onchange=()=>localStorage.setItem('mudraKey',keysel.value);
let keyOptionsBuilt=false;
function ensureKeyOptions(n){
  // Built once, from the server's own expected_keys — the <select> used to
  // ship with 4 hardcoded <option> tags, wrong for anyone configured for a
  // different signer count.
  if(keyOptionsBuilt || !n) return;
  keyOptionsBuilt=true;
  for(let i=1;i<=n;i++){
    const o=document.createElement('option');
    o.value=i; o.textContent='Key '+i;
    keysel.appendChild(o);
  }
  const saved=localStorage.getItem('mudraKey');
  keysel.value=(saved && +saved>=1 && +saved<=n) ? saved : '1';
}
function paintKeysel(detected,detectedFp){
  // Three states, not two: a confirmed slot (green), a device that's
  // physically connected but never registered to any slot (amber — this
  // used to be indistinguishable from "nothing plugged in" because the
  // API dropped the raw fingerprint whenever it didn't resolve to a slot),
  // and truly nothing detected (plain — whatever was last manually picked,
  // stale by definition, hence the warning in the title).
  if(detected){ keysel.value=String(detected); localStorage.setItem('mudraKey',keysel.value); }
  keysel.className=detected?'det':(detectedFp?'unk':'');
  keysel.title=detected?('key '+detected+' detected on USB')
              :detectedFp?(detectedFp+' is plugged in but not mapped to any slot — '
                          +'this picker is a manual guess. Register it: keysetup --map N')
              :'no key detected — pick the one that is plugged in (manual guess, unverified)';
}
const keypanel=document.getElementById('keypanel');
let keysPollTimer=null, lastKeysJSON=null;
// Three tabs, never more than one visible at once — sign (the default),
// keys, and setup used to be a toggle button each, stacking their panels
// alongside the always-visible repo list when more than one was open at
// the same time. One active tab at a time instead.
const tabPanels={sign:document.getElementById('signtab'), keys:keypanel,
                 setup:document.getElementById('setuppanel')};
const tabButtons={sign:document.getElementById('tabSign'), keys:document.getElementById('tabKeys'),
                  setup:document.getElementById('tabSetup')};
let activeTab='sign';
async function switchTab(name){
  if(name===activeTab) return;
  activeTab=name;
  for(const k in tabPanels){
    tabPanels[k].style.display=(k===name)?'block':'none';
    tabButtons[k].className='tab'+(k===name?' active':'');
  }
  if(keysPollTimer){ clearInterval(keysPollTimer); keysPollTimer=null; }
  if(name==='keys'){
    lastKeysJSON=null;
    await refreshKeys();
    // Polls fast enough to feel live while you're physically swapping keys
    // in front of the screen — the panel used to only ever fetch once, on
    // open, so a swap just sat there looking unchanged until you switched
    // away and back.
    keysPollTimer=setInterval(refreshKeys, 2000);
  } else if(name==='setup'){
    await refreshSetup();
  }
}
tabButtons.sign.onclick=()=>switchTab('sign');
tabButtons.keys.onclick=()=>switchTab('keys');
tabButtons.setup.onclick=()=>switchTab('setup');
function trimFp(fp){
  // drop the bit-length and the trailing comment — the comment already
  // shows as its own chip, repeating it next to the hash is just noise
  const m=fp.match(/^\\d+\\s+(\\S+)\\s+\\S+\\s+(\\(.+\\))$/);
  return m?`${m[1]} ${m[2]}`:fp;
}
async function refreshKeys(){
  const r=await fetch('/api/keysetup/status'); const st=await r.json();
  const json=JSON.stringify(st);
  if(json===lastKeysJSON) return;   // nothing changed since the last poll — skip the flicker
  lastKeysJSON=json;
  let html=`<div class="card"><b>key home</b>`+
    chip(st.key_home_exists?'found':'missing — first setup will create it',
         st.key_home_exists?'dimc':'warn')+
    `<span class="fp">${st.key_home}</span>`;
  // A device CAN be detected without being mapped to any slot yet — that's
  // not a detection failure, just nothing to attribute it to (keysetup
  // --map N on the CLI fixes it). Surface the raw fingerprint here so
  // "swapped keys and nothing lit up" reads as "not yet registered", not
  // as "is detection even working".
  if(st.detected_fp && st.mapped_slot==null)
    html+=chip('connected, not mapped to a slot: '+st.detected_fp,'warn');
  html+=`</div>`;
  for(const s of st.slots){
    // "plugged in now" is read-only status — the GUI doesn't offer a manual
    // map action per slot; showing it on every OTHER slot as a correction
    // path was more confusing than useful (looked like a live choice on all
    // 4, not a rare fix-up). `keysetup --map N` still exists on the CLI.
    const pluggedIn=st.detected_fp && st.mapped_slot===s.slot;
    html+=`<div class="card keyslot"><div class="keyslot-head">`;
    html+=`<b>slot ${s.slot}</b>`;
    html+=s.present?chip(s.comment||'set','ok'):chip('empty','dimc');
    if(pluggedIn) html+=chip('plugged in now','ok');
    html+=`<button data-act="gen" data-slot="${s.slot}">`+
          (s.present?'REGENERATE':'GENERATE')+`</button>`;
    html+=`</div>`;
    if(s.fingerprint) html+=`<span class="fp">${trimFp(s.fingerprint)}</span>`;
    html+=`</div>`;
  }
  keypanel.innerHTML=html;
  keypanel.querySelectorAll('button[data-act="gen"]').forEach(b=>b.onclick=async()=>{
    const slot=parseInt(b.dataset.slot);
    const info=st.slots.find(x=>x.slot===slot);
    let msg, force=false;
    if(info.present){
      msg=`Slot ${slot} ALREADY has a key (${info.comment||info.fingerprint||'set'}). `+
        `Regenerating PERMANENTLY retires it — every anchor already armed with its `+
        `public half will need re-arming family-wide. This cannot be undone. `+
        `Plug in the NEW physical key for this slot, then proceed.`;
      force=true;
    } else {
      msg=`Generate a brand-new hardware-backed key for slot ${slot}. Plug in the `+
        `physical key meant for this slot first — it will ask for a PIN, then need `+
        `a TOUCH. mudra never sees the private half either way.`;
    }
    if(!confirm(msg+' Proceed?')) return;
    b.disabled=true;
    await fetch('/api/keysetup/generate',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({slot,force})});
    pollLog();
  });
}
const setuppanel=document.getElementById('setuppanel');
async function refreshSetup(){
  const r=await fetch('/api/setup'); const cfg=await r.json();
  const field=(id,label,value,type)=>
    `<div class="card setupfield"><label for="${id}">${label}</label>`+
    `<input id="${id}" type="${type||'text'}" value="${value}"></div>`;
  let html=`<div class="card"><b>config file</b><span class="fp">${cfg.config_path}</span></div>`;
  html+=field('cfgRepoRoot','repo root',cfg.repo_root);
  html+=field('cfgKeyHome','key home',cfg.key_home);
  html+=field('cfgKeyPrefix','key prefix',cfg.key_prefix);
  html+=field('cfgExpectedKeys','expected keys',cfg.expected_keys,'number');
  html+=field('cfgNamespaceTag','namespace tag',cfg.namespace_tag);
  html+=`<div class="card"><b>roster</b><div id="rosterList"></div>`+
        `<input id="addRepoInput" placeholder="repo name or path">`+
        `<button id="addRepoBtn" class="ghost">add</button></div>`;
  html+=`<button id="saveSetupBtn">SAVE</button>`;
  setuppanel.innerHTML=html;
  let roster=cfg.repos.slice();
  function renderRoster(){
    document.getElementById('rosterList').innerHTML=roster.length
      ? roster.map((r,i)=>`<span class="chip dimc">${r}<button data-i="${i}">×</button></span>`).join('')
      : `<span class="fp">empty — add at least one below</span>`;
    setuppanel.querySelectorAll('#rosterList button').forEach(b=>b.onclick=()=>{
      roster.splice(parseInt(b.dataset.i),1); renderRoster();
    });
  }
  renderRoster();
  document.getElementById('addRepoBtn').onclick=()=>{
    const inp=document.getElementById('addRepoInput');
    const v=inp.value.trim();
    if(v){ roster.push(v); inp.value=''; renderRoster(); }
  };
  document.getElementById('saveSetupBtn').onclick=async()=>{
    const body={
      repo_root: document.getElementById('cfgRepoRoot').value.trim(),
      repos: roster,
      key_home: document.getElementById('cfgKeyHome').value.trim(),
      key_prefix: document.getElementById('cfgKeyPrefix').value.trim(),
      expected_keys: parseInt(document.getElementById('cfgExpectedKeys').value) || 1,
      namespace_tag: document.getElementById('cfgNamespaceTag').value.trim(),
    };
    const r2=await fetch('/api/setup',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify(body)});
    const d2=await r2.json();
    if(d2.error){ alert('Save failed: '+d2.error); return; }
    alert('Saved to '+cfg.config_path+'. Refreshing the roster now.');
    refresh();
  };
}
async function refresh(){
  const r=await fetch('/api/status'); const d=await r.json();
  ensureKeyOptions(d.expected_keys);
  paintKeysel(d.detected, d.detected_fp);
  const el=document.getElementById('repos'); el.innerHTML='';
  for(const s of d.repos){
    const div=document.createElement('div');
    if(s.missing){
      // Render honestly rather than let three absent fields read as three
      // flavors of nothing ('v?' / 'anchor undefined' / 'undefined') — a
      // repo that moved must look like a repo that moved, not a bug in
      // mudra. No ARM button: the ceremony's own repo_state() check
      // already refuses on missing (safe), but offering a control that
      // can only fail is its own kind of dishonest render.
      div.className='card';
      div.innerHTML=`<b>${s.name}</b>`+chip('MISSING: '+s.path,'bad');
      el.appendChild(div);
      continue;
    }
    const armed=s.anchor==='armed';
    // Arm and seal are two separate acts now: arm works on ANY unarmed
    // repo regardless of tag state (that is the whole point — the old
    // combined control rendered nothing at all for an untagged repo);
    // seal only once armed AND a release is actually awaiting it.
    const canArm=!armed && s.anchor!=='unrecognized-layout';
    const canSeal=armed && s.state==='AWAITING SEAL';
    div.className='card'+(canSeal?' queue':'');
    let chips='';
    chips+=chip('v'+(s.version||'?'), s.tagged?'dimc':'warn');
    chips+=chip(armed?'armed':'anchor '+s.anchor,
                armed?'ok':((s.anchor==='none'||s.anchor==='inert')?'dimc':'warn'));
    if(s.embedded_ok===false) chips+=chip('embedded drift','bad');
    if(s.dirty) chips+=chip('dirty tree','warn');
    chips+=chip(s.state, canSeal?'warn':(s.state==='sealed'?'ok':'dimc'));
    div.innerHTML=`<b>${s.name}</b>${chips}`;
    if(canSeal){
      const btn=document.createElement('button');
      btn.textContent='SEAL';
      btn.onclick=async()=>{
        btn.disabled=true;
        await fetch('/api/seal',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({repo:s.name,key:parseInt(keysel.value)})});
        pollLog();
      };
      div.appendChild(btn);
    } else if(canArm){
      const btn=document.createElement('button');
      btn.textContent='ARM';
      btn.onclick=async()=>{
        btn.disabled=true;
        let msg=s.name+': arming pins the master identity FAIL-CLOSED forever.';
        try{
          const pr=await fetch('/api/arm-preview?repo='+encodeURIComponent(s.name));
          const pd=await pr.json();
          if(pd.error){alert(s.name+': cannot arm — '+pd.error);btn.disabled=false;return;}
          msg+=' Will write '+pd.keys.length+' keys: '+pd.keys.join(', ')+'.';
        }catch(e){/* preview is best-effort; the ceremony's own checks still gate the write */}
        if(!confirm(msg+' Proceed?')){btn.disabled=false;return;}
        await fetch('/api/arm',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({repo:s.name})});
        pollLog();
      };
      div.appendChild(btn);
    }
    el.appendChild(div);
  }
}
async function pollLog(){
  const log=document.getElementById('log'); log.style.display='block';
  const t=setInterval(async()=>{
    const r=await fetch('/api/log'); const d=await r.json();
    log.textContent=d.log.map(e=>e.t+'  '+e.msg).join('\\n');
    document.getElementById('touch').style.display=
      d.log.length && d.log[d.log.length-1].msg.includes('TOUCH')?'block':'none';
    if(d.done){
      clearInterval(t);document.getElementById('touch').style.display='none';
      refresh();
      if(activeTab==='keys') refreshKeys();
    }
  },800);
}
refresh(); setInterval(refresh, 30000);
</script></body></html>"""


TOKEN = None   # set by serve(); the desk is single-operator by construction


def polkit_authorize():
    """Gate the desk behind the ACTIVE session's own auth (fingerprint/
    password via whatever agent the desktop has registered), on top of the
    token. Checked against mudra serve's own pid — it runs in the operator's
    graphical session, so the agent prompts on the operator's real screen.

    Fails CLOSED on a real denial (wrong password, cancelled dialog, timeout)
    — that is the entire point. Fails OPEN, loudly, only when polkit itself
    or this action isn't installed yet (pkcheck missing, or the .policy file
    from src/polkit/com.mudra.open-desk.policy hasn't been copied into
    /usr/share/polkit-1/actions/ — that install step needs root and is never
    mudra's to take), so a fresh checkout degrades to token-only instead of
    locking the desk before its first `make install-polkit`."""
    rc, _, err = run(["pkcheck", "-p", str(os.getpid()), "-u",
                      "--action-id", POLKIT_ACTION], timeout=90)
    if rc == 0:
        return True
    if "is not registered" in err or "not found" in err:
        sys.stderr.write(f"mudra: polkit action not installed ({err.strip()}) — "
                         "falling back to token-only. See src/polkit/README.md or "
                         "run `make install-polkit`.\n")
        return True
    return False


def write_session(port, token):
    """So `mudra open` never makes you go fetch the token by hand — written
    atomically (tmp + rename, the status.json seam's own discipline) and
    0600: this file IS a bearer credential for the desk, same trust level as
    the URL it replaces, not a step down from it."""
    os.makedirs(os.path.dirname(SESSION_PATH), exist_ok=True)
    tmp = SESSION_PATH + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"port": port, "token": token, "pid": os.getpid()}, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, SESSION_PATH)


class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, body, ctype="application/json", code=200, cookie=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        if cookie:
            self.send_header("Set-Cookie",
                             f"mudra={cookie}; HttpOnly; SameSite=Strict; Path=/")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *a):
        pass

    def _authed(self):
        """The serve URL carries a one-boot token; the first visit sets it as
        a cookie. Loopback is same-host-ANY-user reachable — the token alone
        used to be the whole gate. Now the token visit ALSO has to clear
        polkit_authorize() (fingerprint/password on the operator's own
        screen) before a cookie is minted — an already-cookied request is
        NOT re-prompted (that would fire on every /api/status poll)."""
        if TOKEN is None:
            return True
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if q.get("token", [None])[0] == TOKEN:
            return polkit_authorize()
        cookies = self.headers.get("Cookie", "")
        return any(c.strip() == f"mudra={TOKEN}" for c in cookies.split(";"))

    def do_GET(self):
        reload_config_if_stale()
        if not self._authed():
            return self._send('{"error":"unauthorized — open the URL the serve '
                              'command printed"}', code=401)
        p = urllib.parse.urlparse(self.path).path
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if p == "/":
            self._send(PAGE.replace("%VER%", MUDRA_VERSION), "text/html",
                       cookie=q.get("token", [None])[0])
        elif p == "/api/status":
            fp = device_fingerprint()
            # "detected" (a resolved slot number) is what the picker needs to
            # auto-select; "detected_fp" is the raw fingerprint, carried
            # through even when it maps to nothing yet — without it, a
            # connected-but-unmapped device is INDISTINGUISHABLE from no
            # device at all to anything reading this endpoint, header
            # included.
            self._send(json.dumps({"repos": scan(),
                                   "detected": load_keymap().get(fp) if fp else None,
                                   "detected_fp": fp,
                                   "expected_keys": EXPECTED_KEYS}))
        elif p == "/api/log":
            self._send(json.dumps({"log": CEREMONY.log, "done": CEREMONY.done,
                                   "active": CEREMONY.active}))
        elif p == "/api/arm-preview":
            name = q.get("repo", [None])[0]
            if name not in ROSTER:
                return self._send('{"error":"unknown repo"}', code=400)
            try:
                body = sync_signers(name, dry=True)
            except SystemExit as exc:
                return self._send(json.dumps({"error": str(exc)}), code=409)
            # Just the trailing comment (key handle name) per line, never the
            # blob — a preview shows WHICH keys, not the key material itself.
            keys = [ln.split()[-1] for ln in body.strip().split("\n") if ln.strip()]
            self._send(json.dumps({"keys": keys}))
        elif p == "/api/keysetup/status":
            self._send(json.dumps(keyslot_status()))
        elif p == "/api/setup":
            self._send(json.dumps(setup_status()))
        else:
            self._send('{"error":"not found"}', code=404)

    def do_POST(self):
        reload_config_if_stale()
        if not self._authed():
            return self._send('{"error":"unauthorized"}', code=401)
        path = urllib.parse.urlparse(self.path).path
        if path not in ("/api/arm", "/api/seal", "/api/keysetup/generate",
                        "/api/keysetup/map", "/api/setup"):
            return self._send('{"error":"not found"}', code=404)
        try:
            n = int(self.headers.get("Content-Length", "0"))
            req = json.loads(self.rfile.read(min(n, 4096)) or "{}")
            if path == "/api/setup":
                repos = req.get("repos")
                if not isinstance(repos, list) or not all(isinstance(r, str) for r in repos):
                    return self._send('{"error":"repos must be a list of strings"}', code=400)
                expected_keys = req.get("expected_keys")
                if not isinstance(expected_keys, int) or expected_keys < 1:
                    return self._send(
                        '{"error":"expected_keys must be a positive integer"}', code=400)
                write_config({
                    "repo_root": str(req.get("repo_root", "")),
                    "repos": repos,
                    "key_home": str(req.get("key_home", "")),
                    "key_prefix": str(req.get("key_prefix", "")),
                    "expected_keys": expected_keys,
                    "namespace_tag": str(req.get("namespace_tag", "")),
                })
                # Unconditional, not just reload_config_if_stale(): this
                # save's own new mtime should win the observation within
                # THIS request, not wait for the next poll's stat() to
                # notice (mtime resolution is whole seconds on some
                # filesystems — a write-then-immediate-read inside the
                # same second must still see the new roster).
                _derive_config()
                return self._send('{"ok":true}')
            if path == "/api/keysetup/map":
                slot = req.get("slot")
                if slot not in range(1, EXPECTED_KEYS + 1):
                    return self._send(json.dumps(
                        {"error": f"slot must be 1-{EXPECTED_KEYS}"}), code=400)
                fp = keymap_register(slot)
                return self._send(json.dumps({"ok": True, "fingerprint": fp}))
            if path == "/api/keysetup/generate":
                slot = req.get("slot")
                if slot not in range(1, EXPECTED_KEYS + 1):
                    return self._send(json.dumps(
                        {"error": f"slot must be 1-{EXPECTED_KEYS}"}), code=400)
                threading.Thread(target=CEREMONY.keysetup,
                                 args=(slot, bool(req.get("force"))),
                                 daemon=True).start()
                return self._send('{"ok":true}')
            name = req.get("repo")
            if name not in ROSTER:
                return self._send('{"error":"unknown repo"}', code=400)
            if path == "/api/arm":
                threading.Thread(target=CEREMONY.arm, args=(name,),
                                 daemon=True).start()
            else:
                key_n = req.get("key")
                if key_n is not None and key_n not in range(1, EXPECTED_KEYS + 1):
                    return self._send(json.dumps(
                        {"error": f"key must be 1-{EXPECTED_KEYS}"}), code=400)
                threading.Thread(target=CEREMONY.seal, args=(name, key_n),
                                 daemon=True).start()
            self._send('{"ok":true}')
        except RuntimeError as exc:
            self._send(json.dumps({"error": str(exc)}), code=409)
        except Exception as exc:
            self._send(json.dumps({"error": type(exc).__name__}), code=500)


# --------------------------------------------------------------------- CLI

def cli_init(args):
    """Interactive setup: configure YOUR OWN roster, key home, and signing
    conventions instead of inheriting anyone else's. Re-runnable — every
    prompt shows the current value (from config, or an already-set env var)
    as its default, so running this again is how you EDIT, not just how
    you START."""
    print("mudra setup — press enter to keep the value shown in [brackets].\n")

    def ask(prompt, current):
        val = input(f"{prompt} [{current}]: ").strip()
        return val or current

    repo_root = ask("Where do your repos live?",
                    _config.get("repo_root", os.path.join(HOME, "code", "REPOS")))

    existing = _config.get("repos", [])
    repos = None
    if existing:
        print(f"\nCurrent roster: {', '.join(existing)}")
        if input("Keep this roster as-is? [Y/n]: ").strip().lower() not in ("n", "no"):
            repos = list(existing)
    if repos is None:
        print("\nWhich repos should mudra track? One at a time — a name under the "
              "repo root above, or a full path (\"mudra\" tracks mudra itself, "
              "same as anything else). Blank line when done.")
        repos = []
        while True:
            entry = input("  repo: ").strip()
            if not entry:
                break
            repos.append(entry)

    key_home = ask("\nWhere should the canonical key home live?",
                    _config.get("key_home", os.path.join(HOME, ".ssh", "mudra-master")))
    key_prefix = ask("Key file/naming prefix (files become id_<prefix>_N)",
                      _config.get("key_prefix", "master"))
    expected_keys = int(ask("How many signing keys (quorum size)?",
                            _config.get("expected_keys", 4)))
    namespace_tag = ask("Extra namespace tag on every anchor line (blank for none)",
                        _config.get("namespace_tag", ""))

    new_config = {
        "repo_root": repo_root, "repos": repos, "key_home": key_home,
        "key_prefix": key_prefix, "expected_keys": expected_keys,
        "namespace_tag": namespace_tag,
    }
    if _config.get("root_layout_repos"):
        new_config["root_layout_repos"] = _config["root_layout_repos"]

    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(new_config, f, indent=2)
        f.write("\n")
    print(f"\nWrote {CONFIG_PATH}. Restart \"mudra serve\" (or just run "
          "\"mudra status\") to pick it up — the roster and key settings are "
          "read once, at startup, not live.")


def cli_status(args):
    if not ROSTER:
        raise SystemExit("no repos configured — run `mudra init` to set up "
                         "your roster (or set MUDRA_REPOS for a one-off run)")
    no_remote = "--no-remote" in args
    states = scan(no_remote)
    if "--json" in args:
        print(json.dumps({"repos": states}, indent=2))
        return
    for s in states:
        if s.get("missing"):
            print(f"{s['name']:<10} MISSING: {s['path']}")
            continue
        ver = s.get("version") or "?"
        print(f"{s['name']:<10} v{ver:<8} anchor={s.get('anchor','?'):<5} "
              f"{'dirty ' if s.get('dirty') else ''}{s.get('state','')}")


def cli_audit(args):
    if not ROSTER:
        raise SystemExit("no repos configured — run `mudra init` to set up "
                         "your roster (or set MUDRA_REPOS for a one-off run)")
    states, findings = audit(no_remote="--remote" not in args)
    for s in states:
        if s.get("missing"):
            print(f"{s['name']:<10} MISSING: {s['path']}")
            continue
        ver = s.get("version") or "?"
        print(f"{s['name']:<10} v{ver:<8} anchor={s.get('anchor','?')}")
    if findings:
        print("\nFINDINGS:")
        for where, what in findings:
            print(f"  {where}: {what}")
        sys.exit(1)
    print("\naudit clean: family invariants hold")


def cli_keysetup(args):
    if "--slot" in args:
        slot = int(args[args.index("--slot") + 1])
        force = "--force" in args
        CEREMONY.keysetup(slot, force=force)
        for e in CEREMONY.log:
            print(f"{e['t']}  {e['msg']}")
        sys.exit(0 if CEREMONY.done == "provisioned" else 1)
    if "--map" in args:
        slot = int(args[args.index("--map") + 1])
        try:
            fp = keymap_register(slot)
        except RuntimeError as exc:
            raise SystemExit(str(exc))
        print(f"slot {slot} <- {fp}")
        return
    st = keyslot_status()
    print(f"key home: {st['key_home']} "
          f"({'exists' if st['key_home_exists'] else 'MISSING'})")
    for s in st["slots"]:
        if not s["present"]:
            print(f"  slot {s['slot']}: empty")
            continue
        mark = " <- plugged in now" if st["mapped_slot"] == s["slot"] and st["detected_fp"] else ""
        print(f"  slot {s['slot']}: {s.get('comment') or '(no comment)'}{mark}")


def cli_open(args):
    """The whole point of a desk instead of a runbook: no command to
    remember, no token to go dig out of the journal. Reads the running
    serve's session file and launches the default browser straight into an
    authenticated desk."""
    try:
        with open(SESSION_PATH) as f:
            sess = json.load(f)
    except FileNotFoundError:
        raise SystemExit("mudra desk isn't running — `systemctl --user "
                         "start mudra` (it should already be enabled to "
                         "autostart; see `systemctl --user status mudra`).")
    try:
        os.kill(sess["pid"], 0)
    except (ProcessLookupError, PermissionError):
        raise SystemExit(f"mudra desk isn't running (stale session, pid "
                         f"{sess['pid']} is gone) — `systemctl --user "
                         "restart mudra`.")
    url = f"http://127.0.0.1:{sess['port']}/?token={sess['token']}"
    if "--print" in args:
        print(url)
        return
    if not webbrowser.open(url):
        raise SystemExit(f"couldn't launch a browser — open this yourself: {url}")


def main():
    reload_config_if_stale()
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__ or "mudra init|status|audit|sync-signers <repo> [--dry]|"
              "arm <repo>|seal <repo>|keysetup|serve [--port N]|open")
        print("mudra init · status [--json] [--no-remote] · audit [--remote] · "
              "sync-signers <repo> [--dry] · arm <repo> · seal <repo> [--key N] · "
              "keysetup [--slot N [--force]] [--map N] · "
              "serve [--port N] · open [--print]")
        return
    cmd, rest = args[0], args[1:]
    if cmd == "init":
        cli_init(rest)
    elif cmd == "status":
        cli_status(rest)
    elif cmd == "audit":
        cli_audit(rest)
    elif cmd == "keysetup":
        cli_keysetup(rest)
    elif cmd == "sync-signers":
        body = sync_signers(rest[0], dry="--dry" in rest)
        print(body if "--dry" in rest else f"{rest[0]}: anchor rebuilt ({EXPECTED_KEYS} keys)")
    elif cmd == "arm":
        CEREMONY.arm(rest[0])
        for e in CEREMONY.log:
            print(f"{e['t']}  {e['msg']}")
        sys.exit(0 if CEREMONY.done == "armed" else 1)
    elif cmd == "seal":
        key_n = int(rest[rest.index("--key") + 1]) if "--key" in rest else None
        CEREMONY.seal(rest[0], key_n=key_n)
        for e in CEREMONY.log:
            print(f"{e['t']}  {e['msg']}")
        sys.exit(0 if CEREMONY.done == "sealed" else 1)
    elif cmd == "serve":
        global TOKEN
        port = int(rest[rest.index("--port") + 1]) if "--port" in rest else PORT
        TOKEN = secrets.token_urlsafe(24)
        write_session(port, TOKEN)
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
        print(f"mudra desk: http://127.0.0.1:{port}/?token={TOKEN}")
        print("(or just run `mudra open`; Ctrl-C to close)")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
    elif cmd == "open":
        cli_open(rest)
    else:
        raise SystemExit(f"unknown command: {cmd}")


if __name__ == "__main__":
    main()
