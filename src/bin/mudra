          msg+=' Will write '+pd.keys.length+' keys: '+pd.keys.join(', ')+'.';
        }catch(e){/* preview is best-effort; the ceremony's own checks still gate the write */}
        if(!confirm(msg+' Proceed?')){btn.disabled=false;return;}
        await fetch('/api/arm',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({repo:s.name})});
        pollLog();
      };
      div.appendChild(btn);
    }
    el.appendChild(div);
