                armed?'ok':((s.anchor==='none'||s.anchor==='inert')?'dimc':'warn'));
    if(s.embedded_ok===false) chips+=chip('embedded drift','bad');
    if(s.dirty) chips+=chip('dirty tree','warn');
    chips+=chip(s.state, canSeal?'warn':(s.state==='sealed'?'ok':'dimc'));
    div.innerHTML=`<b>${s.name}</b>${chips}`;
    if(canSeal){
      const btn=document.createElement('button');
      btn.textContent='SEAL';
      btn.onclick=async()=>{
        btn.disabled=true;
        await fetch('/api/seal',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({repo:s.name,key:parseInt(keysel.value)})});
        pollLog();
      };
      div.appendChild(btn);
    } else if(canArm){
      const btn=document.createElement('button');
      btn.textContent='ARM';
      btn.onclick=async()=>{
        btn.disabled=true;
        let msg=s.name+': arming pins the master identity FAIL-CLOSED forever.';
        try{
          const pr=await fetch('/api/arm-preview?repo='+encodeURIComponent(s.name));
          const pd=await pr.json();
