<script>
const chip=(t,c)=>`<span class="chip ${c}">${t}</span>`;
const keysel=document.getElementById('keysel');
keysel.value=localStorage.getItem('mudraKey')||'1';
keysel.onchange=()=>localStorage.setItem('mudraKey',keysel.value);
function paintKeysel(detected){
  // One physical key at a time is plugged in and it's good for every
  // project — this picker lives in the header, not per-repo card, and
  // detection (when available) always wins over a stale manual pick.
  if(detected){ keysel.value=String(detected); localStorage.setItem('mudraKey',keysel.value); }
  keysel.className=detected?'det':'';
  keysel.title=detected?('key '+detected+' detected on USB')
                       :'no key detected — pick the one that is plugged in';
}
async function refresh(){
  const r=await fetch('/api/status'); const d=await r.json();
  paintKeysel(d.detected);
  const el=document.getElementById('repos'); el.innerHTML='';
  for(const s of d.repos){
    const div=document.createElement('div');
    const armed=s.anchor==='armed';
    // Arm and seal are two separate acts now: arm works on ANY unarmed
    // repo regardless of tag state (that is the whole point — the old
    // combined control rendered nothing at all for an untagged repo);
    // seal only once armed AND a release is actually awaiting it.
    const canArm=!armed && s.anchor!=='unrecognized-layout';
    const canSeal=armed && s.state==='AWAITING SEAL';
    div.className='card'+(canSeal?' queue':'');
    let chips='';
    chips+=chip('v'+(s.version||'?'), s.tagged?'dimc':'warn');
