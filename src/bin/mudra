      d.log.length && d.log[d.log.length-1].msg.includes('TOUCH')?'block':'none';
    if(d.done){clearInterval(t);document.getElementById('touch').style.display='none';refresh();}
  },800);
}
refresh(); setInterval(refresh, 30000);
</script></body></html>"""


TOKEN = None   # set by serve(); the desk is single-operator by construction


def polkit_authorize():
    """Gate the desk behind the ACTIVE session's own auth (fingerprint/
    password via whatever agent the desktop has registered), on top of the
    token. Checked against mudra serve's own pid — it runs in the operator's
    graphical session, so the agent prompts on the operator's real screen.

    Fails CLOSED on a real denial (wrong password, cancelled dialog, timeout)
    — that is the entire point. Fails OPEN, loudly, only when polkit itself
    or this action isn't installed yet (pkcheck missing, or the .policy file
    from src/polkit/com.asuramaya.mudra.policy hasn't been copied into
    /usr/share/polkit-1/actions/ — that install step needs root and is never
    mudra's to take), so a fresh checkout degrades to token-only instead of
    locking the desk before its first `make install-polkit`."""
    rc, _, err = run(["pkcheck", "-p", str(os.getpid()), "-u",
                      "--action-id", POLKIT_ACTION], timeout=90)
    if rc == 0:
        return True
    if "is not registered" in err or "not found" in err:
        sys.stderr.write(f"mudra: polkit action not installed ({err.strip()}) — "
                         "falling back to token-only. See src/polkit/README.md or "
                         "run `make install-polkit`.\n")
        return True
    return False


def write_session(port, token):
    """So `mudra open` never makes you go fetch the token by hand — written
    atomically (tmp + rename, the status.json seam's own discipline) and
    0600: this file IS a bearer credential for the desk, same trust level as
    the URL it replaces, not a step down from it."""
    os.makedirs(os.path.dirname(SESSION_PATH), exist_ok=True)
    tmp = SESSION_PATH + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"port": port, "token": token, "pid": os.getpid()}, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, SESSION_PATH)


class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, body, ctype="application/json", code=200, cookie=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        if cookie:
            self.send_header("Set-Cookie",
                             f"mudra={cookie}; HttpOnly; SameSite=Strict; Path=/")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *a):
        pass

    def _authed(self):
        """The serve URL carries a one-boot token; the first visit sets it as
        a cookie. Loopback is same-host-ANY-user reachable — the token alone
        used to be the whole gate. Now the token visit ALSO has to clear
        polkit_authorize() (fingerprint/password on the operator's own
        screen) before a cookie is minted — an already-cookied request is
        NOT re-prompted (that would fire on every /api/status poll)."""
        if TOKEN is None:
            return True
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if q.get("token", [None])[0] == TOKEN:
            return polkit_authorize()
        cookies = self.headers.get("Cookie", "")
        return any(c.strip() == f"mudra={TOKEN}" for c in cookies.split(";"))

    def do_GET(self):
        if not self._authed():
            return self._send('{"error":"unauthorized — open the URL the serve '
                              'command printed"}', code=401)
        p = urllib.parse.urlparse(self.path).path
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if p == "/":
            self._send(PAGE.replace("%VER%", MUDRA_VERSION), "text/html",
                       cookie=q.get("token", [None])[0])
        elif p == "/api/status":
            self._send(json.dumps({"repos": scan(), "detected": detected_key()}))
        elif p == "/api/log":
            self._send(json.dumps({"log": CEREMONY.log, "done": CEREMONY.done,
                                   "active": CEREMONY.active}))
        elif p == "/api/arm-preview":
            name = q.get("repo", [None])[0]
            if name not in ROSTER:
                return self._send('{"error":"unknown repo"}', code=400)
            try:
                body = sync_signers(name, dry=True)
            except SystemExit as exc:
                return self._send(json.dumps({"error": str(exc)}), code=409)
            # Just the trailing comment (key handle name) per line, never the
            # blob — a preview shows WHICH keys, not the key material itself.
            keys = [ln.split()[-1] for ln in body.strip().split("\n") if ln.strip()]
            self._send(json.dumps({"keys": keys}))
        else:
            self._send('{"error":"not found"}', code=404)

    def do_POST(self):
        if not self._authed():
            return self._send('{"error":"unauthorized"}', code=401)
        path = urllib.parse.urlparse(self.path).path
        if path not in ("/api/arm", "/api/seal"):
            return self._send('{"error":"not found"}', code=404)
        try:
            n = int(self.headers.get("Content-Length", "0"))
            req = json.loads(self.rfile.read(min(n, 4096)) or "{}")
            name = req.get("repo")
            if name not in ROSTER:
                return self._send('{"error":"unknown repo"}', code=400)
            if path == "/api/arm":
                threading.Thread(target=CEREMONY.arm, args=(name,),
                                 daemon=True).start()
            else:
                key_n = req.get("key")
                if key_n is not None and key_n not in (1, 2, 3, 4):
                    return self._send('{"error":"key must be 1-4"}', code=400)
                threading.Thread(target=CEREMONY.seal, args=(name, key_n),
                                 daemon=True).start()
            self._send('{"ok":true}')
        except RuntimeError as exc:
            self._send(json.dumps({"error": str(exc)}), code=409)
        except Exception as exc:
            self._send(json.dumps({"error": type(exc).__name__}), code=500)


# --------------------------------------------------------------------- CLI

def cli_status(args):
    no_remote = "--no-remote" in args
    states = scan(no_remote)
    if "--json" in args:
        print(json.dumps({"repos": states}, indent=2))
        return
    for s in states:
        ver = s.get("version") or "?"
        print(f"{s['name']:<10} v{ver:<8} anchor={s.get('anchor','?'):<5} "
              f"{'dirty ' if s.get('dirty') else ''}{s.get('state','')}")


def cli_audit(args):
    states, findings = audit(no_remote="--remote" not in args)
    for s in states:
        ver = s.get("version") or "?"
        print(f"{s['name']:<10} v{ver:<8} anchor={s.get('anchor','?')}")
    if findings:
        print("\nFINDINGS:")
        for where, what in findings:
            print(f"  {where}: {what}")
        sys.exit(1)
    print("\naudit clean: family invariants hold")


def cli_open(args):
    """The whole point of a desk instead of a runbook: no command to
    remember, no token to go dig out of the journal. Reads the running
    serve's session file and launches the default browser straight into an
    authenticated desk."""
    try:
        with open(SESSION_PATH) as f:
            sess = json.load(f)
    except FileNotFoundError:
        raise SystemExit("mudra desk isn't running — `systemctl --user "
                         "start mudra` (it should already be enabled to "
                         "autostart; see `systemctl --user status mudra`).")
    try:
        os.kill(sess["pid"], 0)
    except (ProcessLookupError, PermissionError):
        raise SystemExit(f"mudra desk isn't running (stale session, pid "
                         f"{sess['pid']} is gone) — `systemctl --user "
                         "restart mudra`.")
    url = f"http://127.0.0.1:{sess['port']}/?token={sess['token']}"
    if "--print" in args:
        print(url)
        return
    if not webbrowser.open(url):
        raise SystemExit(f"couldn't launch a browser — open this yourself: {url}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__ or "mudra status|audit|sync-signers <repo> [--dry]|"
              "arm <repo>|seal <repo>|serve [--port N]|open")
        print("mudra status [--json] [--no-remote] · audit [--remote] · "
              "sync-signers <repo> [--dry] · arm <repo> · seal <repo> [--key N] · "
              "serve [--port N] · open [--print]")
        return
    cmd, rest = args[0], args[1:]
    if cmd == "status":
        cli_status(rest)
    elif cmd == "audit":
        cli_audit(rest)
    elif cmd == "sync-signers":
        body = sync_signers(rest[0], dry="--dry" in rest)
        print(body if "--dry" in rest else f"{rest[0]}: anchor rebuilt ({EXPECTED_KEYS} keys)")
    elif cmd == "arm":
        CEREMONY.arm(rest[0])
        for e in CEREMONY.log:
            print(f"{e['t']}  {e['msg']}")
        sys.exit(0 if CEREMONY.done == "armed" else 1)
    elif cmd == "seal":
        key_n = int(rest[rest.index("--key") + 1]) if "--key" in rest else None
        CEREMONY.seal(rest[0], key_n=key_n)
        for e in CEREMONY.log:
            print(f"{e['t']}  {e['msg']}")
        sys.exit(0 if CEREMONY.done == "sealed" else 1)
    elif cmd == "serve":
        global TOKEN
        port = int(rest[rest.index("--port") + 1]) if "--port" in rest else PORT
        TOKEN = secrets.token_urlsafe(24)
        write_session(port, TOKEN)
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
        print(f"mudra desk: http://127.0.0.1:{port}/?token={TOKEN}")
        print("(or just run `mudra open`; Ctrl-C to close)")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
    elif cmd == "open":
        cli_open(rest)
    else:
        raise SystemExit(f"unknown command: {cmd}")


if __name__ == "__main__":
    main()
